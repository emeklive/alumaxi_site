# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://www.alumaxi.com.br   # PENDENTE: domínio oficial

# ===== Canais oficiais (PENDENTES de confirmação pela empresa) =====
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# WhatsApp comercial (apenas dígitos, com DDI). Padrão: telefone verificado no Google Maps
NEXT_PUBLIC_WHATSAPP_NUMBER=5585998090245

# ===== Google =====
NEXT_PUBLIC_GA_ID=                     # ex.: G-XXXXXXX (carrega somente após consentimento de cookies)
NEXT_PUBLIC_GSC_VERIFICATION=          # código de verificação do Search Console

# ===== Painel administrativo =====
# Sem ADMIN_PASSWORD o painel fica DESATIVADO.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=                  # string aleatória com 32+ caracteres

# ===== Armazenamento (opcional; sem isso grava em ./.data — apenas para desenvolvimento) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=             # somente no servidor, nunca com NEXT_PUBLIC_
SUPABASE_STORAGE_BUCKET=uploads

# ===== Encaminhamento de formulários (opcional) =====
FORMS_WEBHOOK_URL=                     # recebe JSON de cada orçamento/contato/candidatura (Make, Zapier, n8n...)
